# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.

# groq (free tier) | gemini (free tier) | ollama (local, no key) | openai
LLM_PROVIDER=groq
LLM_API_KEY=paste-your-key-here

# Optional: override the default model for the provider
# LLM_MODEL=openai/gpt-oss-120b

# Optional: safety limit on loop iterations per task
# MAX_STEPS=25
